# Copy to .env on the bridge machine. NEVER commit .env (it is in .gitignore).

# --- SAP B1 HANA ---
HANA_HOST=10.0.0.20          # HANA server IP or hostname
HANA_PORT=30015              # SQL port of the tenant DB that holds the company (3<instance>15, or 3<instance>41+)
HANA_USER=DASHBOARD_RO       # read-only user from sql/create_readonly_user.sql
HANA_PASSWORD=
HANA_SCHEMA=SBO_SPYDER       # your SAP B1 company database
HANA_ENCRYPT=true
HANA_VALIDATE_CERT=false

# --- Bridge web server ---
HOST=127.0.0.1               # cloudflared runs on the same machine; keep it off the LAN
PORT=8085

# Comma-separated keys. Each calling app gets its own (the KPI dashboard, the gateway, ...).
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
