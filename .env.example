# Copy to .env on the bridge machine. NEVER commit .env (it is in .gitignore).
# Every line is optional except the HANA connection and API_KEYS. Leave a setting out to use its default (shown).
# The bridge checks every value at start-up and refuses to start, naming the setting, if one is wrong.

# --- SAP B1 HANA ---
HANA_HOST=10.0.0.20          # HANA server IP or hostname
HANA_PORT=30015              # SQL port of the tenant DB that holds the company (3<instance>15, or 3<instance>41+)
HANA_USER=DASHBOARD_RO       # read-only user from sql/create_readonly_user.sql
HANA_PASSWORD=
HANA_SCHEMA=SBO_SPYDER       # your SAP B1 company database
HANA_ENCRYPT=true
# Check that the server is the real HANA (TLS certificate). Default true. Needs HANA's certificate (or the CA that
# signed it) in the Windows certificate store of the account the service runs as, or a file in HANA_TRUSTSTORE.
# An .env from before this setting existed keeps whatever value it has: set true once the certificate is installed.
HANA_VALIDATE_CERT=true
# HANA_TRUSTSTORE=C:\sap-bridge\hana-ca.pem   # optional: a PEM file with HANA's CA certificate, instead of the store
# HANA_CERT_HOSTNAME=spyder-hana1             # optional: the name in HANA's certificate, if HANA_HOST is an IP
HANA_CONNECT_TIMEOUT_MS=15000   # give up connecting after 15 s
HANA_QUERY_TIMEOUT_MS=240000    # give up on a query after 4 minutes

# --- Bridge web server ---
HOST=127.0.0.1               # cloudflared runs on the same machine; keep it off the LAN
PORT=8085
# THREADS=16                 # web server threads (4-64)

# --- Caching, waiting and limits (defaults shown) ---
REFRESH_MIN_SECONDS=30       # refresh=1 reads HANA again at most this often per report
# REQUEST_WAIT_SECONDS=75    # a request waits at most this long for HANA, then gets the last good result or a 503.
#                            # Keep it under Cloudflare's ~100 s limit. HANA runs that take longer still finish and
#                            # fill the cache for the next request.
# FAILURE_BACKOFF_SECONDS=15 # after a failed HANA run, do not try that report or lookup again for this long
# HANA_WAITERS_MAX=14        # at most this many requests wait for HANA at once (at most THREADS - 2, the default),
#                            # so /health and cached answers always have a free thread
# HEALTH_CACHE_SECONDS=15    # /api/health asks HANA at most this often
# LOOKUP_CACHE_MAX=500       # lookups (/api/data) kept in memory; the oldest unused one is dropped first
# LOOKUP_MAX_CONCURRENT=2    # lookups that may run in HANA at the same time
# LOOKUP_MAX_PER_MINUTE=60   # new lookup runs per minute (cached answers do not count)
# REPORT_MAX_ROWS=500000     # a report with more rows counts as a failed run (the last good result stays)
# FETCH_BATCH_ROWS=5000      # rows read from HANA at a time
# GZIP_RESPONSES=false       # true: send reports gzip-compressed to callers that ask for it. Check the dashboard's
#                            # server-side function handles Content-Encoding: gzip before turning this on.
# ENABLED_QUERIES=           # comma-separated lookups to offer; empty = all. A query left out answers 404, like an
#                            # unknown name. Example: ENABLED_QUERIES=open_sales_orders,so_detail,item_stock

# --- Who may call ---
# Comma-separated keys. Give each calling app its own, with a label: label:key  (the label shows in the access log;
# the key never does). A key without a label still works (labelled key1, key2, ...). Keys under 32 characters log a
# warning at start-up. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: API_KEYS=dashboard:<key>,gateway:<another key>
API_KEYS=
